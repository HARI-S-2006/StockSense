# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stocksense?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRY="7d"
SESSION_COOKIE_NAME="stocksense_session"

# Email (Development mode - OTP will be logged to console if not configured)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="StockSense <noreply@stocksense.com>"
EMAIL_FROM="StockSense <noreply@stocksense.com>"

# Development OTP Fallback
DEV_OTP_ENABLED="true"

# Real-time
SOCKET_IO_PORT="3001"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="StockSense"
# API and Socket configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
